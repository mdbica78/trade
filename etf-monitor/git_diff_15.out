diff --git a/etf-monitor/app/api/ai/chat/route.ts b/etf-monitor/app/api/ai/chat/route.ts
index b11acda..538645e 100644
--- a/etf-monitor/app/api/ai/chat/route.ts
+++ b/etf-monitor/app/api/ai/chat/route.ts
@@ -1,12 +1,50 @@
-import { AIService, MockAIProvider } from '@/lib/ai';
-import type { AIRequest } from '@/lib/types';
+import { ConfigurationAssistantService } from '@/lib/ai';
+import { AIProvider, type AIRequest } from '@/lib/types';
 import { NextResponse } from 'next/server';
 
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null;
+}
+
 export async function POST(request: Request) {
-  const provider = new MockAIProvider();
-  const service = new AIService(provider);
-  const aiRequest = (await request.json()) as AIRequest;
-  const aiResponse = await service.chat(aiRequest);
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return NextResponse.json(
+      { success: false, error: 'Invalid request body' },
+      { status: 400 },
+    );
+  }
+
+  if (!isRecord(body) || typeof body.prompt !== 'string') {
+    return NextResponse.json(
+      { success: false, error: 'Prompt is required' },
+      { status: 400 },
+    );
+  }
+
+  const aiRequest: AIRequest = {
+    prompt: body.prompt,
+    provider: undefined,
+    confirm: body.confirm === true,
+    confirmationToken:
+      typeof body.confirmationToken === 'string' ? body.confirmationToken : undefined,
+  };
 
-  return NextResponse.json(aiResponse, { status: 200 });
+  try {
+    const service = new ConfigurationAssistantService();
+    const aiResponse = await service.chat(aiRequest);
+    return NextResponse.json(aiResponse, { status: 200 });
+  } catch (error: unknown) {
+    const message = error instanceof Error ? error.message : 'Unknown error';
+    return NextResponse.json(
+      {
+        provider: AIProvider.MOCK,
+        success: false,
+        message: `Configuration request failed: ${message}`,
+      },
+      { status: 200 },
+    );
+  }
 }
