DATABASE_URL=******host/database?sslmode=require
CRON_SECRET=replace-with-a-long-random-secret

# AI provider configuration
# Supported values in current implementation: mock, ollama, gateway, openai-compatible, openai
# Local development (Ollama): AI_PROVIDER=ollama
# Vercel Production/Preview/Development (AI Gateway): AI_PROVIDER=gateway
AI_PROVIDER=ollama

# Optional override; if unset, a provider-specific default is used
AI_MODEL=qwen2.5:3b-instruct

# Ollama (local development) - optional, defaults to http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Vercel AI Gateway (optional; used when AI_PROVIDER=gateway)
# AI_GATEWAY_BASE_URL defaults to https://ai-gateway.vercel.sh/v1 if unset
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=replace-with-your-ai-gateway-api-key

# OpenAI-compatible endpoint (optional; used when AI_PROVIDER=openai-compatible or openai)
# OPENAI_BASE_URL defaults to https://api.openai.com/v1 if unset
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-openai-api-key
