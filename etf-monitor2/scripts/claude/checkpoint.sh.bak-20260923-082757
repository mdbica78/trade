#!/usr/bin/env bash
# Claude Code Stop hook: snapshot repo state for handover (Claude Code or Copilot).
# Never blocks or fails the session. Output file is git-ignored.
cat >/dev/null 2>&1 || true   # drain hook JSON from stdin
ROOT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}"
cd "$ROOT" 2>/dev/null || exit 0
OUT="dev_minions/.checkpoint.md"
{
  echo "# Auto checkpoint — written by the Claude Code Stop hook. Do not edit."
  echo "- time: $(date -Iseconds)"
  echo "- branch: $(git branch --show-current 2>/dev/null)"
  echo
  echo "## Last commits"
  git log --oneline -5 2>/dev/null | sed 's/^/    /'
  echo
  echo "## Uncommitted changes"
  git status --short 2>/dev/null | sed 's/^/    /'
} > "$OUT" 2>/dev/null
exit 0
