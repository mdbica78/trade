# Neon Postgres connection string used by Drizzle ORM. Set this locally to run
# `pnpm db:migrate`; not required for `pnpm db:generate`, `pnpm test` or `pnpm build`.
DATABASE_URL=

# Shared secret the /api/cron/daily route checks on the Authorization header,
# so only Vercel Cron (not the public internet) can trigger a daily run.
CRON_SECRET=

# Optional override for encrypting keys saved from /admin/ai. Use 32 random bytes
# encoded as base64. Normally leave unset; the app derives a key from CRON_SECRET.
AI_KEY_MASTER_KEY=

# API key for Google Gemini; create it at https://aistudio.google.com/apikey.
# Optional environment-key fallback; /admin/ai can store an encrypted key instead.
GEMINI_API_KEY=

# API key for Groq; create it at https://console.groq.com/keys.
# Optional environment-key fallback; /admin/ai can store an encrypted key instead.
GROQ_API_KEY=

# API key for OpenAI; create it at https://platform.openai.com/api-keys.
# Optional environment-key fallback; /admin/ai can store an encrypted key instead.
OPENAI_API_KEY=

# API key for OpenRouter; create it at https://openrouter.ai/settings/keys.
# Optional environment-key fallback; /admin/ai can store an encrypted key instead.
OPENROUTER_API_KEY=

# API key for Mistral; create it at https://console.mistral.ai/api-keys.
# Optional environment-key fallback; /admin/ai can store an encrypted key instead.
MISTRAL_API_KEY=

# API key for DeepSeek; create it at https://platform.deepseek.com/api_keys.
# Optional environment-key fallback; /admin/ai can store an encrypted key instead.
DEEPSEEK_API_KEY=

# API key for Cerebras; create it at https://cloud.cerebras.ai.
# Optional environment-key fallback; /admin/ai can store an encrypted key instead.
CEREBRAS_API_KEY=

# API key for Together AI; create it at https://api.together.ai/settings/api-keys.
# Optional environment-key fallback; /admin/ai can store an encrypted key instead.
TOGETHER_API_KEY=
