# Neon Postgres connection string used by Drizzle ORM. Set this locally to run
# `pnpm db:migrate`; not required for `pnpm db:generate`, `pnpm test` or `pnpm build`.
DATABASE_URL=

# Shared secret the /api/cron/daily route checks on the Authorization header,
# so only Vercel Cron (not the public internet) can trigger a daily run.
CRON_SECRET=

# API key for Google Gemini; optional until the configuration chat ships (Sprint 6); set it in
# the Vercel project, never commit it.
GEMINI_API_KEY=

# API key for Groq; optional until the configuration chat ships (Sprint 6); set it in the Vercel
# project, never commit it.
GROQ_API_KEY=

# API key for OpenRouter; optional until the configuration chat ships (Sprint 6); set it in the
# Vercel project, never commit it.
OPENROUTER_API_KEY=

# API key for Mistral; optional until the configuration chat ships (Sprint 6); set it in the
# Vercel project, never commit it.
MISTRAL_API_KEY=
