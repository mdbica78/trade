exports[`US-050 AC2: home-table / panel / custom-values golden markup > G-5 (ok): HomePageBody wraps the panel and table 1`] = `"<div class="flex flex-1 flex-col items-center px-4 py-6 sm:px-6"><main class="w-full max-w-[1000px]"><div class="home-title-row" data-home-title-row=""><h1>Monitored ETFs</h1><button type="button" aria-expanded="false" aria-controls="home-customize-panel">Customize view</button></div><div data-table-scroll=""><table><thead><tr><th>Symbol</th><th>Date</th><th>NAV per unit</th></tr></thead><tbody><tr data-home-row="true"><td><a data-home-row-link="true" href="/etf/GAIN">GAIN</a><a href="https://bvb.ro/gain.pdf" target="_blank" rel="noopener noreferrer" data-home-pdf-link="true" aria-label="PDF report for GAIN">PDF</a><div data-home-name="true">Gain ETF</div></td><td data-home-numeric="true">2026-09-22</td><td data-home-numeric="true">11.171<div class="delta-gain" data-home-change="true" title="Compared to the report from 2026-09-21"><span aria-hidden="true">▲</span><span class="sr-only">increased</span> +0.050 +0.45%</div></td></tr><tr data-home-row="true"><td><a data-home-row-link="true" href="/etf/LOSS">LOSS</a><div data-home-name="true">Loss ETF</div></td><td data-home-numeric="true">2026-09-22</td><td data-home-numeric="true">9.900<div class="delta-loss" data-home-change="true" title="Compared to the report from 2026-09-21"><span aria-hidden="true">▼</span><span class="sr-only">decreased</span> -0.100 -1.00%</div></td></tr><tr data-home-row="true"><td><a data-home-row-link="true" href="/etf/FLAT">FLAT</a><div data-home-name="true">Flat ETF</div></td><td data-home-numeric="true">2026-09-22</td><td data-home-numeric="true">10.000<div class="delta-flat" data-home-change="true" title="Compared to the report from 2026-09-21"><span aria-hidden="true">–</span><span class="sr-only">unchanged</span> 0 0.00%</div></td></tr><tr data-home-row="true"><td><a data-home-row-link="true" href="/etf/ZERODIV">ZERODIV</a><div data-home-name="true">Zero Divisor ETF</div></td><td data-home-numeric="true">2026-09-22</td><td data-home-numeric="true">5.000<div class="delta-gain" data-home-change="true" title="Compared to the report from 2026-09-21"><span aria-hidden="true">▲</span><span class="sr-only">increased</span> +5.000</div></td></tr><tr data-home-row="true"><td><a data-home-row-link="true" href="/etf/NODELTA">NODELTA</a><div data-home-name="true">No Delta ETF</div></td><td data-home-numeric="true">2026-09-22</td><td data-home-numeric="true">8.000</td></tr><tr data-home-row="true"><td><a data-home-row-link="true" href="/etf/NOTTRACKED">NOTTRACKED</a><span data-extraction-unavailable="true"> (extraction unavailable)</span><div data-home-name="true">Not Tracked ETF</div></td><td data-home-numeric="true"></td><td data-home-numeric="true"></td></tr><tr data-home-row="true"><td><a data-home-row-link="true" href="/etf/NULLVALUE">NULLVALUE</a><div data-home-name="true">Null Value ETF</div></td><td data-home-numeric="true"></td><td data-home-numeric="true"></td></tr></tbody></table></div></main></div>"`;

exports[`US-050 AC2: home-table / panel / custom-values golden markup > G-6 (en): CustomValues, every operation/value state 1`] = `"<section aria-labelledby="etf-custom-values-heading" class="mt-4"><h2 id="etf-custom-values-heading">Custom values</h2><div class="grid gap-4 sm:grid-cols-2"><article data-widget-slot="1" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Change of NAV per unit over 7 days</h3><p class="delta-gain"><span aria-hidden="true">▲</span><span class="sr-only">increased</span> +2.50</p><p class="text-[var(--muted)]">Based on: 2026-10-05, 2026-09-28</p></article><article data-widget-slot="2" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Change of NAV per unit over 7 days</h3><p class="delta-loss"><span aria-hidden="true">▼</span><span class="sr-only">decreased</span> -1.00</p><p class="text-[var(--muted)]">Based on: 2026-10-05, 2026-09-28</p></article><article data-widget-slot="3" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Change of NAV per unit over 7 days</h3><p class="delta-flat"><span aria-hidden="true">–</span><span class="sr-only">unchanged</span> 0.00</p><p class="text-[var(--muted)]">Based on: 2026-10-05, 2026-09-28</p></article><article data-widget-slot="4" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Percent change of NAV per unit over 7 days</h3><p class="delta-gain"><span aria-hidden="true">▲</span><span class="sr-only">increased</span> +3.20%</p><p class="text-[var(--muted)]">Based on: 2026-10-05, 2026-09-28</p></article><article data-widget-slot="5" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Percent change of NAV per unit over 7 days</h3><p>—</p><p class="text-[var(--muted)]">Based on: 2026-10-05, 2026-09-28</p></article><article data-widget-slot="6" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Average of NAV per unit over 2 reports</h3><p>11.7500</p><p class="text-[var(--muted)]">Based on: 2026-10-05, 2026-10-03</p></article><article data-widget-slot="7" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Custom title</h3><p>Insufficient history</p></article></div></section>"`;

exports[`US-050 AC2: home-table / panel / custom-values golden markup > G-6 (ro): CustomValues, every operation/value state 1`] = `"<section aria-labelledby="etf-custom-values-heading" class="mt-4"><h2 id="etf-custom-values-heading">Valori personalizate</h2><div class="grid gap-4 sm:grid-cols-2"><article data-widget-slot="1" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Variație pentru VUAN pe 7 zile</h3><p class="delta-gain"><span aria-hidden="true">▲</span><span class="sr-only">a crescut</span> +2,50</p><p class="text-[var(--muted)]">Pe baza datelor: 05.10.2026, 28.09.2026</p></article><article data-widget-slot="2" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Variație pentru VUAN pe 7 zile</h3><p class="delta-loss"><span aria-hidden="true">▼</span><span class="sr-only">a scăzut</span> -1,00</p><p class="text-[var(--muted)]">Pe baza datelor: 05.10.2026, 28.09.2026</p></article><article data-widget-slot="3" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Variație pentru VUAN pe 7 zile</h3><p class="delta-flat"><span aria-hidden="true">–</span><span class="sr-only">neschimbat</span> 0,00</p><p class="text-[var(--muted)]">Pe baza datelor: 05.10.2026, 28.09.2026</p></article><article data-widget-slot="4" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Variație procentuală pentru VUAN pe 7 zile</h3><p class="delta-gain"><span aria-hidden="true">▲</span><span class="sr-only">a crescut</span> +3,20%</p><p class="text-[var(--muted)]">Pe baza datelor: 05.10.2026, 28.09.2026</p></article><article data-widget-slot="5" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Variație procentuală pentru VUAN pe 7 zile</h3><p>—</p><p class="text-[var(--muted)]">Pe baza datelor: 05.10.2026, 28.09.2026</p></article><article data-widget-slot="6" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Medie pentru VUAN pe 2 rapoarte</h3><p>11,7500</p><p class="text-[var(--muted)]">Pe baza datelor: 05.10.2026, 03.10.2026</p></article><article data-widget-slot="7" class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--panel)] p-4"><h3>Custom title</h3><p>Istoric insuficient</p></article></div></section>"`;
